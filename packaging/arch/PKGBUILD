# Maintainer: WebMIX <yt.wilde.simon@gmail.com>
#
# WebMIX: OBS Studio with a browser frontend. The package installs the same
# layout as the .deb and the Windows zip: /usr/bin/obs plus a /usr/bin/webmix
# symlink, the plugins under /usr/lib/obs-plugins and the web frontend under
# /usr/share/obs-studio/web.
#
# It provides and conflicts with obs-studio on purpose: only one of the two can
# own /usr/bin/obs, and an old version number would otherwise look like an old
# obs-studio to pacman and be replaced on the next system upgrade.
#
# The release workflow passes the version in WEBMIX_PKGVER; the fallback keeps a
# plain `makepkg` in a checkout working.

pkgname=webmix
pkgver="${WEBMIX_PKGVER:-0.1.0}"
pkgrel=1
pkgdesc='OBS Studio with the WebMIX browser interface (control OBS from any browser)'
arch=('x86_64')
url='https://github.com/fursyt12/WebMIX'
license=('GPL-2.0-only')
depends=(
  'ffmpeg' 'jansson' 'libxinerama' 'libxkbcommon-x11' 'mbedtls3' 'rnnoise'
  'pciutils' 'qt6-svg' 'curl' 'jack' 'pipewire' 'libxcomposite'
  'libdatachannel' 'uthash' 'simde' 'qrcodegencpp-cmake' 'python' 'luajit'
  # What the bundled CEF (the Browser source) needs at runtime.
  'nss' 'nspr' 'libcups' 'expat' 'pango' 'at-spi2-core' 'alsa-lib'
  'libglvnd' 'mesa' 'libdrm' 'libxdamage' 'libxrandr' 'libxfixes' 'libxi'
  'libxkbcommon' 'libx11' 'libxcb'
)
optdepends=(
  'libfdk-aac: FDK AAC codec support'
  'libva-intel-driver: hardware encoding for older Intel GPUs'
  'intel-media-driver: hardware encoding for recent Intel GPUs'
  'libva-mesa-driver: hardware encoding'
  'sndio: Sndio input client'
  'v4l2loopback-dkms: virtual camera support'
  'xdg-desktop-portal-impl: Wayland window/screen capture'
)
makedepends=(
  'base-devel' 'cmake' 'ninja' 'git' 'pkgconf' 'python' 'swig' 'qt6-tools' 'curl'
  'extra-cmake-modules' 'qt6-base' 'qt6-svg' 'qt6-wayland' 'wayland'
  'wayland-protocols' 'libxkbcommon'
  'libx11' 'libxcb' 'libxss' 'libxcomposite' 'libxdamage'
  'libxrandr' 'libxfixes' 'libxi' 'libxinerama' 'libxkbcommon-x11'
  'libglvnd' 'mesa' 'alsa-lib' 'libpulse' 'sndio' 'speexdsp' 'v4l-utils'
  'libva' 'libdrm' 'libpciaccess' 'libfdk-aac' 'mbedtls3' 'pciutils'
  'nlohmann-json' 'websocketpp' 'asio' 'qrcodegencpp-cmake' 'uthash' 'simde'
  'rnnoise' 'libdatachannel' 'pipewire' 'jack2' 'jansson' 'curl' 'ffmpeg'
  'x264' 'librist' 'srt' 'libvpl' 'libusb' 'libpipewire' 'ffnvcodec-headers'
)
provides=('obs-studio')
conflicts=('obs-studio')
options=('!emptydirs')

# The tag is built from the repository itself, because a GitHub tag tarball does
# not carry the obs-websocket submodule the build needs. Tags carry no "v"
# prefix: OBS's own CI derives its version from the tag and rejects "v0.1.0".
source=("webmix::git+${url}.git#tag=${pkgver}")
sha256sums=('SKIP')

prepare() {
  cd "${pkgname}"
  git submodule update --init --recursive

  # The Browser source is obs-browser, which needs a prebuilt Chromium Embedded
  # Framework. Arch has no package for it, so fetch the same tarball OBS's own
  # Linux builds use; the version is the one this checkout pins.
  local cef_version
  cef_version="$(python -c 'import json;d=json.load(open("CMakePresets.json"));print(next(p for p in d["configurePresets"] if p["name"]=="dependencies")["vendor"]["obsproject.com/obs-studio"]["dependencies"]["cef"]["version"])')"
  curl -fL --retry 3 -o "${srcdir}/cef.tar.xz" \
    "https://cdn-fastly.obsproject.com/downloads/cef_binary_${cef_version}_linux_x86_64.tar.xz"
  tar -xf "${srcdir}/cef.tar.xz" -C "${srcdir}"
}

build() {
  cd "${pkgname}"

  local cef_version
  cef_version="$(python -c 'import json;d=json.load(open("CMakePresets.json"));print(next(p for p in d["configurePresets"] if p["name"]=="dependencies")["vendor"]["obsproject.com/obs-studio"]["dependencies"]["cef"]["version"])')"

  # Same configuration the WebMIX test suites run against, plus the Browser
  # source (CEF). The Lua/Python script hosts are still off. Arch installs
  # MbedTLS 3's CMake package under a versioned prefix, which is not on CMake's
  # search path.
  local mbedtls_dir=()
  if [[ -d /usr/lib/mbedtls3/cmake/MbedTLS ]]; then
    mbedtls_dir+=(-DMbedTLS_DIR=/usr/lib/mbedtls3/cmake/MbedTLS)
  fi

  cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    "${mbedtls_dir[@]}" \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DOBS_VERSION_OVERRIDE="${pkgver}" \
    -DWEBMIX_PACKAGE_NAME=webmix \
    -DENABLE_BROWSER=ON \
    -DCEF_ROOT_DIR="${srcdir}/cef_binary_${cef_version}_linux_x86_64" \
    -DENABLE_SCRIPTING=OFF \
    -DENABLE_VLC=OFF \
    -DENABLE_AJA=OFF \
    -Wno-dev

  cmake --build build --parallel
}

package() {
  cd "${pkgname}"
  DESTDIR="${pkgdir}" cmake --install build
}
